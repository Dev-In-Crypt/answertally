# Скопировать в .env.production и заполнить. Файл в git не попадает.
#
# Адреса здесь — внутри сети compose: база это `postgres:5432`, а не
# localhost:5433 из .env для разработки. Скопировать .env сюда нельзя.

# --- Обязательное ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://aisdos:change-me@postgres:5432/aisdos

# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Публичный адрес продукта. Оба значения одинаковы и должны совпадать с тем,
# что видит браузер: по ним строятся ссылки в письмах и в клиентских отчётах.
BETTER_AUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# --- Необязательное: без него продукт работает и честно говорит, чего не может ---

# mock = фикстуры, никаких вызовов и трат. live = настоящие API, требует ключей.
# Умолчание намеренно mock: молча измерять на фикстурах в проде значит
# показывать агентству выдуманные цифры.
ADAPTERS_MODE=mock
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Gemini здесь больше нет: условия Google на grounded-поиск не дают
# анализировать ответы и хранить их так, как нужно продукту. Ключ ничего
# не включит. Разбор: docs/open-questions/gemini-grounding.md
ANTHROPIC_API_KEY=
XAI_API_KEY=

# log = письма пишутся в лог сервера, приглашение и сброс пароля работают
# по ссылке из интерфейса. live = отправка через Resend.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=

# Пусто — продукт не предлагает оплату вовсе, вместо неё говорит, что она
# не подключена. Заданный ключ требует и секрета вебхука, и всех трёх Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Пусто — ошибки идут только в структурный лог.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Порт на хосте. За ним обычно стоит прокси с TLS.
#
# Адрес в значении обязателен, и это не украшение: опубликованный порт
# Docker обходит ufw — правило «закрыто всё, кроме 80 и 443» его не
# касается. Без `127.0.0.1` приложение окажется доступно по адресу машины
# мимо прокси и сертификата, а файрвол покажет, что порт закрыт.
WEB_PORT=127.0.0.1:3000
