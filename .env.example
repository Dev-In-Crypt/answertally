# Скопировать в .env и заполнить. .env в git не попадает.

# --- Database / queue (значения совпадают с docker-compose.yml) ---
# Тесты берут отсюда адрес и работают на базе с суффиксом _test: она создаётся
# и мигрируется сама. Рабочие данные тесты не трогают — они стирают глобальные
# таблицы, и на общей базе один прогон уносил классификацию всех клиентов.
DATABASE_URL=postgresql://aisdos:aisdos@localhost:5433/aisdos
REDIS_URL=redis://localhost:6380

# --- Режим адаптеров платформ ---
# mock = fixture-ответы, сеть не используется (по умолчанию для разработки и тестов)
# live = реальные API, требует ключей ниже
ADAPTERS_MODE=mock

# --- LLM-платформы (нужны только при ADAPTERS_MODE=live) ---
OPENAI_API_KEY=
# Пусто — берётся gpt-6-luna. Прайс модели должен быть в OPENAI_PRICING,
# иначе адаптер откажется стартовать: стоимость ответа обязана записываться.
OPENAI_MODEL=
# Пусто — medium. Уровень управляет числом обращений модели к поиску, то есть
# и стоимостью ответа, и тем, сколько источников попадёт в диагностику.
# Менять осознанно: измерения сравнимы только внутри одного уровня.
OPENAI_REASONING_EFFORT=
PERPLEXITY_API_KEY=
# Пусто — пресет fast Agent API (преемник sonar: один поиск, один шаг).
# Отвечает он моделью OpenAI (gpt-5.6-luna) поверх поиска Perplexity — модель
# пишется в model_version каждого ответа. Прайс пресета — в PERPLEXITY_PRICING.
PERPLEXITY_PRESET=
# Пусто — https://api.perplexity.ai/v1/agent. Sonar (/v1/sonar) отключён 2026-09-27.
PERPLEXITY_ENDPOINT=
# Gemini не измеряется: условия Google на grounded-поиск не дают ни
# анализировать ответы, ни хранить их так, как это нужно продукту, чтобы
# цифру можно было перепроверить. Адаптер цел, но не регистрируется — ключ
# здесь ничего не включит, и переменных для него больше нет.
# Разбор условий: docs/open-questions/gemini-grounding.md
# Claude. Включается в расписании клиента осознанно — по умолчанию не измеряется.
ANTHROPIC_API_KEY=
# Только если ключ создан на уровне организации, а не привязан к workspace:
# консоль отдаёт invalid_request_error ещё до модели без этого заголовка.
# Взять в Settings → Workspaces → нужный workspace → ID в адресе страницы.
ANTHROPIC_WORKSPACE_ID=
# Пусто — берётся claude-sonnet-5 ($2/$10 за 1M токенов вход/выход — не Haiku, не Opus/Fable).
# Прайс модели должен быть в CLAUDE_PRICING.
CLAUDE_MODEL=
# Пусто — https://api.anthropic.com/v1/messages
CLAUDE_ENDPOINT=
# Пусто — web_search_20250305. У провайдера версии инструмента выходят рядом.
CLAUDE_SEARCH_TOOL=
# Сколько раз за ответ модели разрешено искать. Пусто — 3. Потолок входит в
# отметку версии ответа: меняйте осознанно, измерения сравнимы только внутри него.
CLAUDE_MAX_SEARCHES=
# Grok (xAI). Включается в расписании клиента осознанно — по умолчанию не измеряется.
XAI_API_KEY=
# Пусто — берётся grok-4.20-0309-non-reasoning ($1.25/$2.50 за 1M токенов вход/выход).
# Прайс модели должен быть в GROK_PRICING. Точная строка id не гарантирована
# документацией xAI — live-check вернёт точную ошибку, если она неверна.
GROK_MODEL=
# Пусто — https://api.x.ai/v1/responses
GROK_ENDPOINT=


# --- App / auth ---
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Адрес, по которому веб открывает сам себя, чтобы напечатать отчёт в PDF.
# Пусто — берётся NEXT_PUBLIC_APP_URL. В боевом образе задан как
# http://127.0.0.1:3000: публичный адрес изнутри контейнера может быть недоступен.
INTERNAL_APP_URL=
# Путь к системному Chromium для печати PDF. Пусто — браузер, который ставит
# Playwright (разработка и тесты). В боевом образе задан.
CHROMIUM_EXECUTABLE_PATH=
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# --- Почта ---
# log = письма никуда не уходят, текст пишется в лог сервера (по умолчанию).
#       Ссылку на приглашение и отчёт интерфейс показывает сам; ссылки
#       подтверждения адреса и сброса пароля — только в логе сервера.
# live = письма уходят через Resend, требует ключа ниже. В продакшене
#       (docker-compose.prod.yml) переменная обязательна — см. .env.production.example.
EMAIL_MODE=log
RESEND_API_KEY=
# Домен отправителя должен быть подтверждён в Resend, иначе письма отвергаются.
# Пусто — Answertally <noreply@answertally.com>.
EMAIL_FROM=

# --- Оплата ---
# Пусто — продукт работает на лимитах starter и честно говорит, что оплату
# не принимает: никакого поддельного checkout. Заданный ключ требует и
# секрета вебхука (иначе план агентства мог бы выдать себе кто угодно),
# и всех трёх Price ID: половина настроенных планов хуже, чем ни одного.
# Оплата через Creem (Merchant of Record). Ключ creem_test_… работает с
# тестовым API, живой — с боевым. Без ключа оплата честно выключена.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_STARTER=
CREEM_PRODUCT_GROWTH=
CREEM_PRODUCT_SCALE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# --- Аналитика ---
# Пусто — живого чтения нет, работает импорт выгрузки (колонки date, source,
# sessions). Продукт при этом честно говорит, что подключения нет.
# Заданное значение потребует живого читателя GA4 — он появится за тем же
# интерфейсом, что и остальные внешние вызовы.
GA4_CREDENTIALS_JSON=

# --- Сайт: контакт продаж и домен отчётов ---
# Пока контакта нет, кнопка «поговорить с нами» рядом с «Run a free audit» не
# показывается и звонок нигде не обещается. Достаточно одной из двух переменных.
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SALES_URL=
# Пусто — «Book a 20-min walkthrough» при URL, «Talk to us» при одной почте.
NEXT_PUBLIC_SALES_LABEL=
# Домен, на котором открываются клиентские отчёты. Пусто — тот же домен, что
# и у продукта. Свой домен агентства убирает последний след стороннего
# поставщика со страницы, которую читает клиент.
NEXT_PUBLIC_REPORT_HOST=

# --- Рекламные метки витрины (Google Ads, Meta, LinkedIn) ---
# Пусто — метки не грузятся, баннера согласия нет, страница о куках говорит
# «ничего не ставим». Метки грузятся только после «Accept all» и только на
# витрине: на странице клиентского отчёта и в продукте их нет. Значения
# попадают в бандл на сборке — на проде их задают переменными репозитория GitHub.
# Google Ads: идентификатор AW-... и метка конверсии «регистрация».
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
# Meta Pixel (Facebook, Instagram): числовой идентификатор пикселя.
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag: Partner ID и идентификатор конверсии «регистрация».
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_SIGNUP_CONVERSION_ID=

# --- Observability ---
# Пусто — ошибки идут только в структурный лог (обычный режим разработки).
# Задан — дополнительно уходят в Sentry; серверная часть web и worker читают его.
SENTRY_DSN=
# Отдельный DSN для браузера: он попадает в бандл и публичен по определению.
NEXT_PUBLIC_SENTRY_DSN=
# Окружение и версия в Sentry. Пусто — NODE_ENV и без версии.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Cloudflare Turnstile (проверка «не бот» на регистрации и в предпросмотре вопросов).
# Без секрета проверка выключена. Ключ сайта публичный, секрет — только здесь.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# DataForSEO (Google AI Overviews и AI Mode): base64 от login:password из app.dataforseo.com → API Access.
DATAFORSEO_AUTH=
