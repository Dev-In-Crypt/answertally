# Обратный прокси и сертификат. Домены берутся из SITE_DOMAIN в
# .env.production: несколько адресов через запятую.
#
# Сертификат Caddy получает сам и продлевает сам. Условие одно: записи DNS
# указывают на эту машину напрямую, без прокси Cloudflare. С включённым
# прокси Cloudflare сам оконечивает TLS, и режим «Flexible» дал бы
# бесконечный редирект — Caddy гонит на HTTPS, Cloudflare возвращает по HTTP.
# Адрес посетителя Caddy ставит сам: присланные посетителем X-Forwarded-*
# по умолчанию игнорируются, чтобы их нельзя было подделать. Ограничитель
# регистраций поэтому видит настоящий адрес без дополнительной настройки.
#
# Если однажды перед машиной встанет прокси Cloudflare, адресом посетителя
# окажется адрес Cloudflare, и все пользователи сольются в несколько общих
# счётчиков. Тогда нужен глобальный `trusted_proxies` с диапазонами
# Cloudflare — а не переписывание заголовка: оно затёрло бы настоящий адрес.
{$SITE_DOMAIN} {
	# Тело запроса больше десяти мегабайт продукту не нужно ни для чего
	# (логотип — два), а без потолка его читал бы в память веб.
	request_body {
		max_size 10MB
	}
	# Журнал запросов в stdout контейнера: без него разбирать флуд и
	# злоупотребления было не по чему.
	# Адрес запроса в журнал не пишется: в нём токены-доступы — ссылка на
	# отчёт клиента, приглашение, сброс пароля. Для разбора флуда хватает
	# адреса клиента, метода, статуса и времени. Замена по регулярному
	# выражению не взята намеренно: фигурные скобки в ней Caddyfile читает
	# как подстановку, и ошибка в конфиге уронила бы прокси целиком.
	log {
		output stdout
		format filter {
			request>uri delete
		}
	}
	# www — только вход на основной адрес. Отдавать на нём само приложение
	# нельзя: куки входа и адрес возврата привязаны к основному домену, и
	# вход на www зависал на «Please wait…».
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent
	reverse_proxy web:3000
}

# Аналитика сайта (Umami). Тот же порядок с сертификатом: запись DNS без
# прокси Cloudflare. Журнал не пишется: адреса посетителей сюда не нужны.
{$STATS_DOMAIN} {
	reverse_proxy umami:3000
}
