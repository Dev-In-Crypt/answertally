# Обратный прокси и сертификат. Домены берутся из SITE_DOMAIN в
# .env.production: несколько адресов через запятую.
#
# Сертификат Caddy получает сам и продлевает сам. Условие одно: записи DNS
# указывают на эту машину напрямую, без прокси Cloudflare. С включённым
# прокси Cloudflare сам оконечивает TLS, и режим «Flexible» дал бы
# бесконечный редирект — Caddy гонит на HTTPS, Cloudflare возвращает по HTTP.
{$SITE_DOMAIN} {
	reverse_proxy web:3000 {
		# Адрес посетителя переписывается, а не дополняется.
		#
		# Иначе заголовок, присланный самим посетителем, остаётся в начале
		# списка, и приложение видит два адреса вместо одного. Ограничитель
		# частоты в таком случае не может выбрать настоящий и сваливает всех
		# в общий счётчик — то есть любой желающий одной строкой в запросе
		# закрывает регистрацию всему миру.
		header_up X-Forwarded-For {remote_host}
	}
}
