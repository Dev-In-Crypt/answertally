{
  "name": "answertally",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "_comment_test": "concurrency=1: пакеты с интеграционными тестами делят одну базу, параллельно они удаляют данные друг друга",
    "test": "turbo run test --concurrency=1",
    "lint": "eslint .",
    "e2e": "pnpm --filter @repo/web run e2e",
    "db:generate": "pnpm --filter @repo/db run generate",
    "db:migrate": "pnpm --filter @repo/db run migrate",
    "db:seed": "pnpm --filter @repo/db run seed && pnpm --filter @repo/pipeline run seed:demo",
    "db:check": "pnpm --filter @repo/db run check",
    "db:studio": "pnpm --filter @repo/db run studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
